# ReturnRide Environment Configuration
# Copy this file to .env.local when connecting your Supabase project

# Supabase URL (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Default Locale (en-PK)
NEXT_PUBLIC_DEFAULT_LOCALE=en-PK

# Personal Gmail SMTP for Real OTP Delivery to User Inboxes
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Generate an App Password (myaccount.google.com/apppasswords)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

